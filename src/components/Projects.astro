---
import GitHub from "./icons/GitHub.astro";
import Link from "./icons/Link.astro";
import LinkButton from "./LinkButton.astro";

const PROJECTS = [
  {
    title: "Aplicación Bancaria & Onboarding Financiero (BDG S.A.)",
    description:
      "Lideré la integración de reconocimiento facial biométrico (FacePhi) y OCR para la incorporación digital de clientes en la banca, junto con SDKs de monitoreo para detección de vulnerabilidades. Desarrollé APIs de alta seguridad para información sensible bajo estándares estrictos del sector financiero.",
    image: "/projects/web-wrapp.png",
    tags: [
      { name: "Biometría FacePhi / OCR", class: "bg-purple-950/40 text-purple-300 border-purple-800/50" },
      { name: "Node.js", class: "bg-emerald-950/40 text-emerald-300 border-emerald-800/50" },
      { name: "Java Spring Boot", class: "bg-orange-950/40 text-orange-300 border-orange-800/50" },
      { name: "Oracle PL/SQL", class: "bg-red-950/40 text-red-300 border-red-800/50" },
      { name: "Ionic / Angular", class: "bg-blue-950/40 text-blue-300 border-blue-800/50" },
    ],
  },
  {
    title: "Sistema de Gestión Logística & Ventas de Metales (BDG S.A.)",
    description:
      "Desarrollo de solución multiplataforma para el reporte en tiempo real y gestión operativa de logística de metales. Diseñé y desplegué la arquitectura backend escalable utilizando contenedores Docker sobre AWS con notificaciones masivas OneSignal.",
    image: "/projects/nestjs-ms.png",
    tags: [
      { name: "React Native", class: "bg-sky-950/40 text-sky-300 border-sky-800/50" },
      { name: "NestJS", class: "bg-red-950/40 text-red-300 border-red-800/50" },
      { name: "Docker & AWS", class: "bg-cyan-950/40 text-cyan-300 border-cyan-800/50" },
      { name: "PostgreSQL & MongoDB", class: "bg-indigo-950/40 text-indigo-300 border-indigo-800/50" },
      { name: "OneSignal", class: "bg-amber-950/40 text-amber-300 border-amber-800/50" },
    ],
  },
  {
    title: "Somos Progreso – Control de Personal & Geofencing (Sysavan)",
    description:
      "Implementación de un sistema automatizado de Geofencing para marcaciones de ingreso y salida en tiempo real. Desarrollado para Cementos Progreso, mejorando drásticamente el control y precisión de asistencia del personal en campo.",
    link: "https://play.google.com/store/apps/details?id=com.mc.cemprog",
    github: "https://github.com/wralonzo/app-marcajes",
    image: "/projects/flutter-app.png",
    tags: [
      { name: "Flutter / Dart", class: "bg-cyan-950/40 text-cyan-300 border-cyan-800/50" },
      { name: "Geofencing & GPS", class: "bg-emerald-950/40 text-emerald-300 border-emerald-800/50" },
      { name: "Google Maps API", class: "bg-blue-950/40 text-blue-300 border-blue-800/50" },
      { name: "SQLite Offline", class: "bg-indigo-950/40 text-indigo-300 border-indigo-800/50" },
    ],
  },
  {
    title: "NestJS Microservices Monorepo & API Gateway",
    description:
      "Arquitectura distribuida de microservicios con API Gateway centralizado para orquestar la comunicación interna entre microservicios de Ventas y Clientes. Incluye CQRS, registrador en AWS CloudWatch y arquitectura limpia.",
    link: "https://github.com/wralonzo/nestjs-monorepo-ms",
    github: "https://github.com/wralonzo/nestjs-monorepo-ms",
    image: "/projects/java-retail.png",
    tags: [
      { name: "NestJS", class: "bg-red-950/40 text-red-300 border-red-800/50" },
      { name: "Microservicios", class: "bg-indigo-950/40 text-indigo-300 border-indigo-800/50" },
      { name: "TypeScript", class: "bg-blue-950/40 text-blue-300 border-blue-800/50" },
      { name: "Docker", class: "bg-cyan-950/40 text-cyan-300 border-cyan-800/50" },
    ],
  },
];
---

<div class="flex flex-col gap-y-12">
  {
    PROJECTS.map(({ image, title, description, tags, link, github }) => (
      <article class="flex flex-col space-x-0 space-y-6 group md:flex-row md:space-x-8 md:space-y-0 p-6 rounded-2xl bg-white/70 dark:bg-zinc-900/60 border border-zinc-200/80 dark:border-zinc-800 shadow-sm backdrop-blur-sm transition duration-300 hover:border-indigo-500/50 hover:shadow-lg">
        <div class="w-full md:w-1/2 overflow-hidden rounded-xl border border-zinc-200 dark:border-zinc-700/60">
          <img
            alt={title}
            class="object-cover object-center w-full h-56 sm:h-64 transition duration-500 group-hover:scale-105"
            loading="lazy"
            src={image}
          />
        </div>

        <div class="w-full md:w-1/2 flex flex-col justify-between">
          <div>
            <h3 class="text-2xl font-bold text-zinc-900 dark:text-zinc-100">
              {title}
            </h3>

            <div class="flex flex-wrap gap-1.5 mt-3 mb-4">
              {tags.map((tag) => (
                <span
                  class={`px-2.5 py-1 rounded-md text-xs font-semibold border ${tag.class}`}
                >
                  {tag.name}
                </span>
              ))}
            </div>

            <p class="text-zinc-700 dark:text-zinc-300 text-sm leading-relaxed">
              {description}
            </p>
          </div>

          <footer class="flex items-center justify-start mt-6 gap-x-4">
            {github && (
              <LinkButton href={github}>
                <GitHub class="size-4" />
                Ver Código
              </LinkButton>
            )}
            {link && (
              <LinkButton href={link}>
                <Link class="size-4" />
                Ver Proyecto
              </LinkButton>
            )}
          </footer>
        </div>
      </article>
    ))
  }
</div>
