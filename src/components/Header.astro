---
import ThemeToggle from "./ThemeToggle.astro";
import LanguageToggle from "./LanguageToggle.astro";
import MailIcon from "./icons/Mail.astro";

const navItems = [
  {
    title: "Inicio",
    i18nKey: "nav.home",
    label: "inicio",
    url: "/#inicio",
  },
  {
    title: "Experiencia",
    i18nKey: "nav.experience",
    label: "experiencia",
    url: "/#experiencia",
  },
  {
    title: "Proyectos",
    i18nKey: "nav.projects",
    label: "proyectos",
    url: "/#proyectos",
  },
  {
    title: "Habilidades",
    i18nKey: "nav.skills",
    label: "habilidades",
    url: "/#habilidades",
  },
  {
    title: "Servicios",
    i18nKey: "nav.services",
    label: "servicios",
    url: "/#servicios",
  },
  {
    title: "Educación",
    i18nKey: "nav.education",
    label: "educacion",
    url: "/#educacion",
  },
  {
    title: "Sobre mí",
    i18nKey: "nav.about",
    label: "sobre-mi",
    url: "/#sobre-mi",
  },
];
---

<header
  class="fixed top-0 z-50 flex items-center justify-center w-full mx-auto mt-3 sm:mt-4 px-4 pointer-events-none"
>
  <!-- Desktop Executive Glassmorphism Navbar -->
  <nav
    class="pointer-events-auto hidden md:flex items-center justify-between gap-4 px-5 py-2 rounded-full backdrop-blur-xl bg-white/80 dark:bg-zinc-900/80 border border-zinc-200/80 dark:border-zinc-800/80 shadow-xl shadow-zinc-950/5 dark:shadow-black/40 w-full max-w-5xl transition-all duration-300"
  >
    <!-- Brand Avatar & Name -->
    <a
      href="/#inicio"
      class="flex items-center gap-2.5 text-sm font-bold text-zinc-900 dark:text-zinc-100 hover:text-indigo-600 dark:hover:text-indigo-400 transition group"
    >
      <div class="relative">
        <img
          src="/projects/profile.jpeg"
          alt="Willian Alonzo"
          class="size-8 rounded-full object-cover ring-2 ring-indigo-500/50 group-hover:scale-105 transition"
        />
        <span class="absolute bottom-0 right-0 size-2.5 rounded-full bg-emerald-500 ring-2 ring-white dark:ring-zinc-900"></span>
      </div>
      <span class="tracking-tight">Willian Alonzo</span>
    </a>

    <!-- Center Navigation Links -->
    <div class="flex items-center gap-1">
      {
        navItems.map((link) => (
          <a
            class="nav-link relative block px-2.5 py-1.5 text-xs sm:text-sm font-medium transition-all duration-200 rounded-full whitespace-nowrap text-zinc-600 dark:text-zinc-300 hover:text-indigo-600 dark:hover:text-indigo-400 hover:bg-zinc-100 dark:hover:bg-zinc-800/80"
            aria-label={link.label}
            data-i18n={link.i18nKey}
            href={link.url}
          >
            {link.title}
          </a>
        ))
      }
    </div>

    <!-- Right Controls: Language Toggle, Theme Toggle & Contact Button -->
    <div class="flex items-center gap-2">
      <LanguageToggle />
      <ThemeToggle />
      <a
        href="mailto:williamalonzo4519@gmail.com?subject=Consulta%20de%20Servicios%20Freelance%20-%20Willian%20Alonzo"
        class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-semibold text-white bg-indigo-600 hover:bg-indigo-500 rounded-full shadow-sm hover:shadow-indigo-500/20 transition active:scale-95 whitespace-nowrap"
      >
        <MailIcon class="size-3.5" />
        <span data-i18n="nav.contact">Contáctame</span>
      </a>
    </div>
  </nav>

  <!-- Mobile Minimalist Floating Bar -->
  <div
    class="pointer-events-auto flex md:hidden flex-col w-full max-w-md mx-auto"
  >
    <div
      class="flex items-center justify-between px-4 py-2.5 rounded-full backdrop-blur-xl bg-white/85 dark:bg-zinc-900/85 border border-zinc-200/80 dark:border-zinc-800/80 shadow-lg shadow-zinc-900/5 dark:shadow-black/40"
    >
      <a
        href="/#inicio"
        class="flex items-center gap-2 text-sm font-bold text-zinc-900 dark:text-zinc-100"
      >
        <img
          src="/projects/profile.jpeg"
          alt="Willian Alonzo"
          class="size-7 rounded-full object-cover ring-1 ring-indigo-500"
        />
        <span>Willian Alonzo</span>
      </a>

      <div class="flex items-center gap-2">
        <LanguageToggle />
        <ThemeToggle />
        <button
          id="mobile-menu-btn"
          aria-label="Abrir menú"
          class="p-1.5 text-zinc-700 dark:text-zinc-300 hover:bg-zinc-100 dark:hover:bg-zinc-800 rounded-lg transition"
        >
          <svg
            id="hamburger-icon"
            class="size-6"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            xmlns="http://www.w3.org/2000/svg"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
          <svg
            id="close-icon"
            class="size-6 hidden"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            xmlns="http://www.w3.org/2000/svg"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>
      </div>
    </div>

    <!-- Mobile Dropdown Menu -->
    <div
      id="mobile-menu"
      class="hidden mt-2 p-3 rounded-2xl backdrop-blur-xl bg-white/95 dark:bg-zinc-900/95 border border-zinc-200/80 dark:border-zinc-800/80 shadow-2xl space-y-1"
    >
      {
        navItems.map((link) => (
          <a
            class="mobile-nav-link block px-4 py-2.5 text-sm font-medium text-zinc-700 dark:text-zinc-300 rounded-xl hover:bg-indigo-50 dark:hover:bg-indigo-950/60 hover:text-indigo-600 dark:hover:text-indigo-400 transition"
            aria-label={link.label}
            data-i18n={link.i18nKey}
            href={link.url}
          >
            {link.title}
          </a>
        ))
      }
      <a
        href="mailto:williamalonzo4519@gmail.com?subject=Consulta%20de%20Servicios%20Freelance%20-%20Willian%20Alonzo"
        class="mobile-nav-link flex items-center justify-center gap-2 px-4 py-2.5 text-sm font-semibold text-white bg-indigo-600 hover:bg-indigo-500 rounded-xl transition mt-2"
      >
        <MailIcon class="size-4" />
        <span data-i18n="nav.requestQuote">Solicitar Cotización</span>
      </a>
    </div>
  </div>
</header>

<script>
  document.addEventListener("astro:page-load", () => {
    // Mobile Menu Toggle Logic
    const menuBtn = document.getElementById("mobile-menu-btn");
    const mobileMenu = document.getElementById("mobile-menu");
    const hamburgerIcon = document.getElementById("hamburger-icon");
    const closeIcon = document.getElementById("close-icon");
    const mobileLinks = document.querySelectorAll(".mobile-nav-link");

    menuBtn?.addEventListener("click", () => {
      mobileMenu?.classList.toggle("hidden");
      hamburgerIcon?.classList.toggle("hidden");
      closeIcon?.classList.toggle("hidden");
    });

    mobileLinks.forEach((link) => {
      link.addEventListener("click", () => {
        mobileMenu?.classList.add("hidden");
        hamburgerIcon?.classList.remove("hidden");
        closeIcon?.classList.add("hidden");
      });
    });

    // Active Section Observer Logic for Desktop and Mobile
    const sections = document.querySelectorAll("section");
    const navItems = document.querySelectorAll("header a[aria-label]");

    const callback = (entries: any[]) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          navItems.forEach((item) => {
            if (item.getAttribute("aria-label") === entry.target.id) {
              item.classList.add(
                "text-indigo-600",
                "dark:text-indigo-400",
                "bg-indigo-50/80",
                "dark:bg-indigo-950/60",
                "font-semibold",
              );
            } else {
              item.classList.remove(
                "text-indigo-600",
                "dark:text-indigo-400",
                "bg-indigo-50/80",
                "dark:bg-indigo-950/60",
                "font-semibold",
              );
            }
          });
        }
      });
    };

    const observer = new IntersectionObserver(callback, {
      root: null,
      rootMargin: "-20% 0px -60% 0px",
      threshold: 0,
    });

    sections.forEach((section) => {
      observer.observe(section);
    });

    document.onvisibilitychange = () => {
      if (document.visibilityState === "hidden") {
        observer.disconnect();
      } else {
        sections.forEach((section) => {
          observer.observe(section);
        });
      }
    };
  });
</script>
