---
import LinkInline from "./LinkInline.astro";

interface Props {
  title: string;
  company: string;
  description: string;
  link?: string;
  date: string;
  tools: string;
  highlights?: string[];
  dateKey?: string;
  titleKey?: string;
  companyKey?: string;
  descKey?: string;
  h1Key?: string;
  h2Key?: string;
  h3Key?: string;
}

const {
  title,
  company,
  description,
  link,
  date,
  tools,
  highlights,
  dateKey,
  titleKey,
  companyKey,
  descKey,
  h1Key,
  h2Key,
  h3Key,
} = Astro.props;

const highlightKeys = [h1Key, h2Key, h3Key].filter(Boolean);
---

<div
  class="relative pl-6 pb-12 group last:pb-0 before:absolute before:left-0 before:top-2 before:bottom-0 before:w-[2px] before:bg-gradient-to-b before:from-indigo-500 before:to-transparent"
>
  <span
    class="absolute left-[-5px] top-2 size-3 rounded-full bg-indigo-600 ring-4 ring-white dark:ring-zinc-900 group-hover:scale-125 transition duration-300"
  ></span>

  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-1 mb-2">
    <div>
      <h3 data-i18n={titleKey} class="text-xl font-bold text-zinc-900 dark:text-zinc-100">
        {title}
      </h3>
      <h4 data-i18n={companyKey} class="text-base font-semibold text-indigo-600 dark:text-indigo-400">
        {company}
      </h4>
    </div>
    <time data-i18n={dateKey} class="text-xs font-semibold px-3 py-1 rounded-full bg-zinc-100 dark:bg-zinc-800 text-zinc-600 dark:text-zinc-400 w-fit">
      {date}
    </time>
  </div>

  <p data-i18n={descKey} class="text-zinc-700 dark:text-zinc-300 leading-relaxed text-sm sm:text-base my-3">
    {description}
  </p>

  {highlights && highlights.length > 0 && (
    <ul class="mb-4 space-y-1.5 text-sm text-zinc-700 dark:text-zinc-300">
      {highlights.map((item, idx) => (
        <li class="flex items-start gap-2">
          <span class="text-indigo-500 font-bold">✓</span>
          <span data-i18n={highlightKeys[idx]}>{item}</span>
        </li>
      ))}
    </ul>
  )}

  <div class="flex flex-wrap gap-1.5 mt-3 mb-4">
    {tools.split(",").slice(0, 10).map((tool) => (
      <span class="px-2.5 py-0.5 text-xs font-medium bg-indigo-50/70 dark:bg-indigo-950/40 text-indigo-700 dark:text-indigo-300 rounded border border-indigo-100 dark:border-indigo-900/40">
        {tool.trim()}
      </span>
    ))}
  </div>

  {
    link && (
      <div class="mt-2">
        <LinkInline href={link}>
          <span data-i18n="exp.viewSite">Ver sitio / empresa</span>{" "}
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="size-4 inline ml-0.5"
            viewBox="0 0 24 24"
            stroke-width="2"
            stroke="currentColor"
            fill="none"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path stroke="none" d="M0 0h24v24H0z" fill="none" />
            <path d="M9 6l6 6l-6 6" />
          </svg>
        </LinkInline>
      </div>
    )
  }
</div>
