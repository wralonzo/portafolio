---
const { href } = Astro.props;
const isExternal = href?.startsWith("http");
---

<a
  href={href}
  target={isExternal ? "_blank" : "_self"}
  rel={isExternal ? "noopener noreferrer" : undefined}
  role="link"
  class="inline-flex items-center justify-center gap-2 px-3 py-2 space-x-2 text-sm font-medium text-zinc-900 dark:text-zinc-100 transition bg-zinc-100 dark:bg-zinc-800 border border-zinc-300 dark:border-zinc-700 rounded-xl hover:bg-zinc-200 dark:hover:bg-zinc-700 hover:border-zinc-400 dark:hover:border-zinc-600 focus:outline-none focus-visible:ring-2 focus-visible:ring-indigo-500 max-w-fit"
>
  <slot />
</a>
