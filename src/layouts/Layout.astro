---
import "@fontsource-variable/onest";

import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { ViewTransitions } from "astro:transitions";

interface Props {
  title: string;
  description: string;
  image?: string;
}

const { description, title, image = "https://avatars.githubusercontent.com/u/26682095?v=4" } = Astro.props;
const siteUrl = "https://wralonzo.netlify.app";
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <meta name="google-site-verification" content="google932d3a053da4cdc7" />
    <meta id="meta-theme-color" name="theme-color" content="#fafafa" />
    <link rel="canonical" href={siteUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- Synchronous Inline Script for Immediate Theme Application on iOS & Android -->
    <script is:inline>
      (function() {
        const getTheme = () => {
          if (typeof localStorage !== "undefined" && localStorage.getItem("theme")) {
            return localStorage.getItem("theme");
          }
          return window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
        };

        const theme = getTheme();
        const isDark = theme === "dark";
        if (isDark) {
          document.documentElement.classList.add("dark");
          document.documentElement.style.colorScheme = "dark";
        } else {
          document.documentElement.classList.remove("dark");
          document.documentElement.style.colorScheme = "light";
        }

        const themeMeta = document.getElementById("meta-theme-color");
        if (themeMeta) {
          themeMeta.setAttribute("content", isDark ? "#09090b" : "#fafafa");
        }
      })();
    </script>

    <!-- Security Headers Meta Tags -->
    <meta http-equiv="X-Content-Type-Options" content="nosniff" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta http-equiv="X-Frame-Options" content="DENY" />

    <!-- Open Graph / Facebook / LinkedIn -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={siteUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:site_name" content="Willian Alonzo Portafolio" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={siteUrl} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />

    <!-- Google Structured Data (JSON-LD) for Search Engine Indexing -->
    <script type="application/ld+json" is:inline>
      {
        "@context": "https://schema.org",
        "@type": "Person",
        "name": "Willian Alonzo",
        "alternateName": "wralonzo",
        "jobTitle": "Full Stack & Mobile Engineer",
        "url": "https://wralonzo.netlify.app",
        "image": "https://avatars.githubusercontent.com/u/26682095?v=4",
        "sameAs": [
          "https://github.com/wralonzo",
          "https://www.linkedin.com/in/willian-alonzo-952288173/",
          "https://gitlab.com/wralonzo"
        ],
        "knowsAbout": [
          "Full Stack Software Development",
          "Flutter",
          "React Native",
          "Kotlin Multiplatform (KMP)",
          "Jetpack Compose",
          "Node.js",
          "NestJS",
          "Rust",
          "Spring Boot",
          "AWS",
          "Docker"
        ],
        "address": {
          "@type": "PostalAddress",
          "addressCountry": "GT",
          "addressLocality": "Guatemala"
        }
      }
    </script>

    <ViewTransitions />
  </head>

  <body class="relative text-zinc-800 dark:text-zinc-100 bg-zinc-50 dark:bg-zinc-950 transition-colors duration-300">
    <!-- Smooth background radial glow with solid fallbacks -->
    <div
      class="fixed inset-0 z-[-10] min-h-screen w-full pointer-events-none
      bg-[radial-gradient(ellipse_80%_80%_at_50%_-20%,rgba(120,119,198,0.15),#fafafa)]
      dark:bg-[radial-gradient(ellipse_80%_80%_at_50%_-20%,rgba(79,70,229,0.15),#09090b)]"
    >
    </div>

    <Header />
    
    <div class="pt-24 sm:pt-28 pb-12">
      <slot />
    </div>

    <Footer />

    <style is:global>
      html:not(.dark),
      html:not(.dark) body {
        color-scheme: light !important;
        background-color: #fafafa !important;
      }

      html.dark,
      html.dark body {
        color-scheme: dark !important;
        background-color: #09090b !important;
      }

      html {
        font-family: "Onest Variable", system-ui, sans-serif;
        scroll-behavior: smooth;
      }

      body {
        display: flex;
        flex-direction: column;
        min-height: 100vh;
        overscroll-behavior: none;
      }

      @media (prefers-reduced-motion: reduce) {
        html {
          scroll-behavior: auto;
        }
      }
    </style>
  </body>
</html>
